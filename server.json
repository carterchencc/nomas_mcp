{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.carterchencc/nomas",
  "title": "Nomas Research",
  "description": "Structured SEC data: company facts, parsed filings, insider trades, 13F holdings, and FTD.",
  "version": "1.3.0",
  "websiteUrl": "https://nomas.fyi/research/mcp",
  "repository": {
    "url": "https://github.com/carterchencc/nomas_mcp",
    "source": "github",
    "id": "1338807281"
  },
  "icons": [
    {
      "src": "https://nomas.fyi/images/icon-192.png",
      "mimeType": "image/png",
      "sizes": ["192x192"]
    },
    {
      "src": "https://nomas.fyi/images/icon-512.png",
      "mimeType": "image/png",
      "sizes": ["512x512"]
    }
  ],
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://mcp.nomas.fyi/mcp",
      "headers": [
        {
          "name": "X-API-Key",
          "description": "Named API key from nomas.fyi. Optional if the client uses OAuth Connect.",
          "isRequired": false,
          "isSecret": true
        }
      ]
    }
  ]
}
